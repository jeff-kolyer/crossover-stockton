{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossoverstockton.org/schemas/initiative.schema.json",
  "title": "Initiative",
  "description": "An effort to address a gap.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "intended_outcome": {
      "type": "string",
      "minLength": 1
    },
    "gap_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "organization_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "development_stage": {
      "type": "string",
      "minLength": 1
    },
    "operational_status": {
      "type": "string",
      "minLength": 1
    },
    "funding_status": {
      "type": "string",
      "minLength": 1
    },
    "construction_contract_amount_usd": {
      "type": "number",
      "description": "Awarded construction contract amount, supported by the initiative's funding source. This is a contract value, not operating capacity."
    },
    "evidence_record_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "last_verified_at": {
      "$ref": "./common.schema.json#/$defs/date"
    },
    "visual_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional subject or scene Crossover wants an independent renderer to understand; not alt text or evidence."
    },
    "preferred_image": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred illustrative image path or URL; the renderer may use another image or none."
    },
    "logo_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional description of the record's authentic visual identity or symbol; not alt text."
    },
    "preferred_logo": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred existing logo path or URL. Do not present an invented mark as an organization's official logo."
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "gap_ids",
    "organization_ids",
    "development_stage",
    "operational_status",
    "funding_status",
    "evidence_record_ids"
  ],
  "additionalProperties": true
}
