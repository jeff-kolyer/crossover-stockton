{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossoverstockton.org/schemas/finding.schema.json",
  "title": "Finding",
  "description": "finding information definition. Schema describes source data, not page layout.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "investigation_id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "established",
        "developing",
        "contradicted",
        "insufficient_evidence",
        "preliminary",
        "exploratory"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "primary_objective_id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "supporting_record_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "contradicting_record_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "related_objective_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed_at": {
      "$ref": "./common.schema.json#/$defs/date"
    },
    "current": {
      "type": "boolean"
    },
    "visual_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional subject or scene Crossover wants an independent renderer to understand; not alt text or evidence."
    },
    "preferred_image": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred illustrative image path or URL; the renderer may use another image or none."
    },
    "logo_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional description of the record's authentic visual identity or symbol; not alt text."
    },
    "preferred_logo": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred existing logo path or URL. Do not present an invented mark as an organization's official logo."
    }
  },
  "required": [
    "id",
    "investigation_id",
    "title",
    "status",
    "statement",
    "supporting_record_ids",
    "contradicting_record_ids",
    "limitations",
    "last_reviewed_at"
  ],
  "additionalProperties": true
}
