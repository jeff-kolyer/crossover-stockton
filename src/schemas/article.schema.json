{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossoverstockton.org/schemas/article.schema.json",
  "title": "article",
  "description": "article information definition. Schema describes source data, not page layout.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "$ref": "./common.schema.json#/$defs/date"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "published": {
      "type": "boolean"
    },
    "related_gap_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "related_location_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "path",
    "title",
    "date",
    "type",
    "description",
    "summary"
  ],
  "additionalProperties": true
}
