{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossoverstockton.org/schemas/view.schema.json",
  "title": "view",
  "description": "view information definition. Schema describes source data, not page layout.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "method": {
      "type": "string",
      "enum": [
        "prose",
        "media-list",
        "media-grid",
        "collection-index",
        "disclosure-list",
        "timeline",
        "evidence-list",
        "finding-explanation",
        "statistics",
        "geographic-map",
        "split-investigation-workspace"
      ]
    },
    "options": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "method"
  ],
  "additionalProperties": true
}
