{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossoverstockton.org/schemas/claim.schema.json",
  "title": "Claim",
  "description": "claim information definition. Schema describes source data, not page layout.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "reported_estimate",
        "reported_count",
        "administrative_count",
        "unknown_quantity",
        "editorial_interpretation"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "source_reported",
        "official_reported",
        "not_established",
        "crossover_interpretation"
      ]
    },
    "sourceRecordIds": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "reportedValue": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "geographicScopeId": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "measurementId": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "visual_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional subject or scene Crossover wants an independent renderer to understand; not alt text or evidence."
    },
    "preferred_image": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred illustrative image path or URL; the renderer may use another image or none."
    },
    "logo_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional description of the record's authentic visual identity or symbol; not alt text."
    },
    "preferred_logo": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred existing logo path or URL. Do not present an invented mark as an organization's official logo."
    },
    "gap_id": {
      "$ref": "./common.schema.json#/$defs/id"
    }
  },
  "required": [
    "id",
    "statement",
    "kind",
    "verificationStatus",
    "sourceRecordIds",
    "limitations",
    "gap_id"
  ],
  "additionalProperties": true
}
