{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossoverstockton.org/schemas/location.schema.json",
  "title": "Location",
  "description": "location information definition. Schema describes source data, not page layout.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "investigation_id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "area": {
      "type": "string",
      "minLength": 1
    },
    "coordinates": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "historical_published_report",
        "recent_public_report",
        "official_location_record",
        "crossover_firsthand"
      ]
    },
    "evidence_date": {
      "$ref": "./common.schema.json#/$defs/date"
    },
    "source_url": {
      "type": "string"
    },
    "evidence_record_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "verification_status": {
      "type": "string",
      "minLength": 1
    },
    "unknown": {
      "type": "string",
      "minLength": 1
    },
    "visual_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional subject or scene Crossover wants an independent renderer to understand; not alt text or evidence."
    },
    "preferred_image": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred illustrative image path or URL; the renderer may use another image or none."
    },
    "logo_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional description of the record's authentic visual identity or symbol; not alt text."
    },
    "preferred_logo": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred existing logo path or URL. Do not present an invented mark as an organization's official logo."
    }
  },
  "required": [
    "id",
    "investigation_id",
    "name",
    "area",
    "coordinates",
    "category",
    "evidence_date",
    "source_url",
    "verification_status",
    "unknown"
  ],
  "additionalProperties": true
}
