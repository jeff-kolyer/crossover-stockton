{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossoverstockton.org/schemas/objective.schema.json",
  "title": "Investigation objective",
  "description": "objective information definition. Schema describes source data, not page layout.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "investigation_id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "action_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "activity_record_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "evidence_record_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "visual_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional subject or scene Crossover wants an independent renderer to understand; not alt text or evidence."
    },
    "preferred_image": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred illustrative image path or URL; the renderer may use another image or none."
    },
    "logo_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional description of the record's authentic visual identity or symbol; not alt text."
    },
    "preferred_logo": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred existing logo path or URL. Do not present an invented mark as an organization's official logo."
    }
  },
  "required": [
    "id",
    "investigation_id",
    "title",
    "description",
    "action_ids",
    "activity_record_ids",
    "evidence_record_ids",
    "finding_ids"
  ],
  "additionalProperties": true
}
