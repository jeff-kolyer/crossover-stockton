{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossoverstockton.org/schemas/identity.schema.json",
  "title": "Identity",
  "description": "identity information definition. Schema describes source data, not page layout.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slogan": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "geographicScope": {
      "$ref": "./common.schema.json#/$defs/geographicScope"
    },
    "founderPersonId": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "principleIds": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "methodIds": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "statements": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "visual_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional subject or scene Crossover wants an independent renderer to understand; not alt text or evidence."
    },
    "preferred_image": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred illustrative image path or URL; the renderer may use another image or none."
    },
    "logo_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional description of the record's authentic visual identity or symbol; not alt text."
    },
    "preferred_logo": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred existing logo path or URL. Do not present an invented mark as an organization's official logo."
    }
  },
  "required": [
    "id",
    "name",
    "slogan",
    "purpose",
    "geographicScope",
    "founderPersonId",
    "principleIds",
    "methodIds"
  ],
  "additionalProperties": true
}
