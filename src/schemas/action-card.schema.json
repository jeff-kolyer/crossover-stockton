{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossoverstockton.org/schemas/action-card.schema.json",
  "title": "Action page card",
  "type": "object",
  "properties": {
    "id": { "$ref": "./common.schema.json#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      },
      "required": ["src", "alt", "width", "height"],
      "additionalProperties": false
    },
    "active": { "type": "boolean" },
    "href": { "type": "string", "minLength": 1 },
    "buttonLabel": { "type": "string", "minLength": 1 },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "./common.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "label"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "title", "summary", "image", "active", "href", "buttonLabel", "metrics"],
  "additionalProperties": false
}
