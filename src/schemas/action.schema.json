{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossoverstockton.org/schemas/action.schema.json",
  "title": "Task",
  "description": "action information definition. Schema describes source data, not page layout.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "order_by_id": {
      "type": "number"
    },
    "investigation_id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "waiting",
        "done",
        "cancelled"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "application",
        "inquiry",
        "field_observation",
        "records_request",
        "follow_up",
        "source_review",
        "organization_contact",
        "policy_monitoring"
      ]
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "list_context": {
      "type": "string",
      "minLength": 1
    },
    "list_date_label": {
      "type": "string",
      "minLength": 1
    },
    "location_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "organization_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "objective_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "basis_record_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "activity_record_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "completed_at": {
      "$ref": "./common.schema.json#/$defs/date"
    },
    "visual_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional subject or scene Crossover wants an independent renderer to understand; not alt text or evidence."
    },
    "preferred_image": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred illustrative image path or URL; the renderer may use another image or none."
    },
    "logo_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional description of the record's authentic visual identity or symbol; not alt text."
    },
    "preferred_logo": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred existing logo path or URL. Do not present an invented mark as an organization's official logo."
    }
  },
  "required": [
    "id",
    "order_by_id",
    "investigation_id",
    "title",
    "status",
    "type",
    "instructions",
    "location_ids",
    "organization_ids",
    "objective_ids",
    "basis_record_ids",
    "activity_record_ids"
  ],
  "additionalProperties": true
}
