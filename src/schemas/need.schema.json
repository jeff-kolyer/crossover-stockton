{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossoverstockton.org/schemas/need.schema.json",
  "title": "Need",
  "description": "need information definition. Schema describes source data, not page layout.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "slug": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "critical",
        "high_priority",
        "monitored",
        "improving"
      ]
    },
    "investigation_status": {
      "type": "string",
      "enum": [
        "investigating",
        "identified"
      ]
    },
    "active": {
      "type": "boolean"
    },
    "organization_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "record_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "story_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "first_seen": {
      "anyOf": [
        {
          "$ref": "./common.schema.json#/$defs/date"
        },
        {
          "$ref": "./common.schema.json#/$defs/dateTime"
        }
      ]
    },
    "updated_at": {
      "anyOf": [
        {
          "$ref": "./common.schema.json#/$defs/date"
        },
        {
          "$ref": "./common.schema.json#/$defs/dateTime"
        }
      ]
    },
    "unknown_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "visual_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional subject or scene Crossover wants an independent renderer to understand; not alt text or evidence."
    },
    "preferred_image": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred illustrative image path or URL; the renderer may use another image or none."
    },
    "logo_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional description of the record's authentic visual identity or symbol; not alt text."
    },
    "preferred_logo": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred existing logo path or URL. Do not present an invented mark as an organization's official logo."
    },
    "thumbnail_image": {
      "type": "string",
      "minLength": 1,
      "description": "Optional thumbnail variant of the preferred image for compact displays."
    }
  },
  "required": [
    "id",
    "slug",
    "title",
    "summary",
    "status",
    "investigation_status"
  ],
  "additionalProperties": true
}
