{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossoverstockton.org/schemas/story.schema.json",
  "title": "Story",
  "description": "story information definition. Schema describes source data, not page layout.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "slug": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "gap_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "organization_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "published_at": {
      "$ref": "./common.schema.json#/$defs/date"
    },
    "source_url": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "visual_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional subject or scene Crossover wants an independent renderer to understand; not alt text or evidence."
    },
    "preferred_image": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred illustrative image path or URL; the renderer may use another image or none."
    },
    "logo_description": {
      "type": "string",
      "minLength": 1,
      "description": "Optional description of the record's authentic visual identity or symbol; not alt text."
    },
    "preferred_logo": {
      "type": "string",
      "minLength": 1,
      "description": "Optional preferred existing logo path or URL. Do not present an invented mark as an organization's official logo."
    }
  },
  "required": [
    "id",
    "slug",
    "title",
    "summary",
    "gap_ids",
    "organization_ids"
  ],
  "additionalProperties": true
}
