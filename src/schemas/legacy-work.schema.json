{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossoverstockton.org/schemas/legacy-work.schema.json",
  "title": "legacy-work",
  "description": "legacy-work information definition. Schema describes source data, not page layout.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "gap_id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "record_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "activity_record_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "project_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "organization_ids": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "gap_id",
    "title",
    "summary",
    "status",
    "type"
  ],
  "additionalProperties": true
}
