  "fieldDescriptions": {
    "map_reference_location_ids": "Nearby public geographic references for a task. These are not necessarily task sites or observed animal locations.",
    "location_type": "What kind of physical place this is. It is independent of category, which classifies the evidence or source associated with the location.",
    "contact_activity_ids": "Firsthand, occurred Crossover Activity records that identify this organization. A nonempty list means Crossover approached or heard from it; inspect each Activity's organization_interaction and outcome before claiming a response, visit, acceptance, or collaboration. Organizations without this field may still be referenced in research.",
    "organization_ids": "Organizations related to this record. On outside evidence this is a reference, not evidence of Crossover contact.",
    "occurred_at": "When the activity happened, independent of when it was confirmed, recorded, or published.",
    "confirmed_at": "When Crossover confirmed a previously received item had arrived; this does not replace the receipt date.",
    "recorded_at": "When Crossover documented the activity in its records; this does not replace the event date.",
    "started_at": "When work on a task began; this does not imply completion."
  },
