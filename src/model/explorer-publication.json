  "experienceSpec": {
    "version": 1,
    "premise": "The public feed tracks what Crossover does and what the evidence says about reality. Interfaces, charts, videos, and other views may be generated from it. Visual style is a separate layer and must not change the meaning of records.",
    "navigation": [
      {
        "label": "Home",
        "route": "/",
        "purpose": "Introduce Crossover and the current focus."
      },
      {
        "label": "Gaps",
        "route": "/gaps",
        "purpose": "Choose a gap and follow its activity, findings, metrics, and sources."
      },
      {
        "label": "Activity",
        "route": "/activity",
        "purpose": "Show the work Crossover has done and the next useful actions."
      },
      {
        "label": "Places",
        "route": "/places",
        "purpose": "Show geographic references and their source records without implying that a report is verified at an exact point."
      },
      {
        "label": "Explore",
        "route": "/explore",
        "purpose": "Make the full public feed easy to search, filter, inspect, and reuse."
      },
      {
        "label": "About",
        "route": "/about",
        "purpose": "Explain Crossover, its people, principles, and method."
      },
      {
        "label": "Connect",
        "buttonLabel": "Connect on LinkedIn",
        "role": "contact",
        "urlField": "person.profileUrl",
        "purpose": "Name the destination in the button and use the published profile link; never invent contact details."
      }
    ],
    "appearance": "Keep the current site's visual rules in docs/SITE_DESIGN.md as one presentation skin. Other skins can render the same feed without changing its records or this information architecture."
  },
  "visualGuidance": {
    "preferredAssets": "Preferred images and logos express a preference, not layout instructions. A renderer may use an appropriate alternative or no image.",
    "descriptions": "Visual and logo descriptions describe an intended subject or identity; they are not alt text. Alt text must describe the image actually shown.",
    "evidence": "Illustrative or generated imagery is not investigation evidence. Documentary images retain separate source, attribution, and caption information.",
    "logos": "Do not present an invented logo as an organization's official logo.",
    "imageDisclosure": {
      "scope": "Do not place a generic image label over artwork or illustrations. Keep the image's origin, description, and evidence status in the feed. Site branding and navigation icons are excluded.",
      "documentaryImages": "When an image documents a real event or place, provide its source and context near the image. Do not treat artwork or generated imagery as investigation evidence."
    }
  },
  "browseGuidance": {
    "defaultTypeFilter": "all",
    "defaultLayout": "flat",
    "defaultSort": "dateForSort.value descending",
    "undatedPlacement": "last",
    "tieBreak": "id ascending",
    "defaultView": "Open browseable records with All types in one flat list, newest first by dateForSort.value. Preserve the mixed types unless the visitor filters or groups them.",
    "filtering": "Search and type filters retain the same newest-first order. Put undated records after dated records; break equal-date ties by stable record ID ascending. Do not invent a date for an undated record.",
    "dateMeaning": "dateForSort.field identifies what the date means. Event occurrence, receipt confirmation, documentation, publication, review start, completion, and verification are distinct. Label the selected field; never move an event date to the day it was recognized or recorded. dateForSort is a browse key, not a claim that every record was published or changed that day."
  },
  "locationGuidance": {
    "googleMapsSearchUrl": "https://www.google.com/maps/search/?api=1&query={encodeURIComponent(map_reference.query)}",
    "presentation": "For a Location with a nonempty map_reference.query, show a prominent Open in Google Maps link alongside its internal Crossover record link. Generate the URL from the query; do not store a duplicate URL on every record.",
    "precision": "map_reference.precision describes the geographic search term, not a verified event, dog, person, or current condition. Corridors and general areas must be presented as broad references. map_reference.verified means the place name or address itself has a documented source; it does not verify associated reports.",
    "embeddedMaps": "map_reference.embed_url is a Google Maps Share > Embed a map URL for a verified street address. Show it with the precision warning and Open in Google Maps link. Keep broad or unverified geographic references as search links rather than pinned embeds."
  },
