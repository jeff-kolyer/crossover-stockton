    },
    {
      "id": "stories",
      "region": "body",
      "source": "stories",
      "filter": "featured",
      "order": "published-desc",
      "limit": 3,
      "method": "media-list",
      "renderer": "home-stories"
    },
    {
      "id": "navigation",
      "region": "body",
      "source": "site-navigation",
      "filter": "home",
      "order": "rank",
      "method": "collection-index",
      "renderer": "home-navigation"
